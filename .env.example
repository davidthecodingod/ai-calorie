# AI Calorie configuration
# Port the local app serves on
PORT=4273

# --- Publik API (preferred) ---
# Issued by publik; the app uses this for food-photo analysis.
PUBLIK_API_URL=https://publikhq.com/api/v1
PUBLIK_APP_TOKEN=

# --- Own-key fallback ---
# Used only when no publik token is present.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
