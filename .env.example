# AI Calorie configuration
# Port the local app serves on
PORT=4273

# --- Publik API (preferred) ---
# Normally you do not set this: a released build ships publik-app-token.txt and
# provisions a per-install key on first launch. Set it only to override that.
# Where to get one: https://publikhq.com/developers
PUBLIK_API_URL=https://publikhq.com/api/v1
PUBLIK_APP_TOKEN=

# --- Own-key fallback ---
# Optional. If set, your own key is used in preference to publik API.
# Where to get one: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
