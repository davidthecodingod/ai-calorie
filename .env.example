# AI Calorie configuration
# Port the local app serves on
PORT=4273

# --- Publik API ---
# Nothing to set. AI Calorie ships publik-app-token.txt and provisions its own
# per-install key the first time you use an AI feature, after asking you.
# (Developers only: PUBLIK_API_KEY / PUBLIK_API_BASE_URL override that.)

# --- Own-key fallback ---
# Optional. If set, your own key is used in preference to publik API.
# Where to get one: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
